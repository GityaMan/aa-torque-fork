+/** Расчёт расхода для бензинового мотора по массовому расходу воздуха (MAF). */
+object Fuel {
+    /** Стехиометрическое соотношение воздух/топливо для бензина. */
+    const val AFR = 14.7
+    /** Плотность бензина, г/л. */
+    const val DENSITY = 745.0
+
+    /**
+     * Мгновенный расход, л/ч. MAF (г/с) / (14.7 × λ) = топливо г/с.
+     * λ — заданная блоком (PID 44); если блок её не отдаёт, считаем смесь стехиометрической.
+     * При отсечке топлива на торможении двигателем λ уходит выше 1.5 — расход ноль.
+     */
+    fun litersPerHour(e: ObdEngine): Double? {
+        val maf = e.readId("10") ?: return null
+        val lambda = if (e.has(0x44)) e.readId("44") ?: 1.0 else 1.0
+        if (lambda > 1.5) return 0.0
+        val l = if (lambda < 0.5) 1.0 else lambda
+        return maf / (AFR * l) / DENSITY * 3600.0 * e.fuelK()
+    }
+
+    /** Мгновенный расход, л/100 км. На скорости ниже 5 км/ч не считается (делить не на что). */
+    fun litersPer100(e: ObdEngine): Double? {
+        val lph = litersPerHour(e) ?: return null
+        val v = e.readId("0d") ?: return null
+        if (v < 5) return null
+        return (lph / v * 100.0).coerceAtMost(99.0)
+    }
+}
