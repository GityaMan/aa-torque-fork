index 0352308..4219874 100644
--- a/app/build.gradle
+++ b/app/build.gradle
@@ -14,15 +14,18 @@ def versionMajor = props.getProperty("majorVersion") as Integer
 def versionMinor = props.getProperty("minorVersion") as Integer
 def versionPatch = props.getProperty("patchVersion") as Integer
 def acraVersion = '5.11.3'
-def ghOwner = "Rilard-T"
-def ghPackage = "aa-torque-fork"
+// Исходники и канал обновлений — репозиторий, в котором идёт сборка (GitHub Actions задаёт GITHUB_REPOSITORY).
+// При сборке вне GitHub обновления отключены, чтобы не подтянуть дизельную версию из оригинального форка.
+def ghRepo = System.getenv("GITHUB_REPOSITORY") ?: ""
+def repoUrl = ghRepo ? "https://github.com/${ghRepo}" : "https://github.com/Rilard-T/aa-torque-fork"
+def releaseUrl = ghRepo ? "https://api.github.com/repos/${ghRepo}/releases/latest" : ""
 
 
 android {
     namespace "com.aatorque.stats"
     compileSdk 34
     defaultConfig {
-        applicationId "com.aamazda.monitor"
+        applicationId "com.aamazda.petrol"   // отдельный пакет: ставится рядом с дизельной версией
         minSdkVersion 28
         targetSdkVersion 34
         versionCode versionMajor * 1000 + versionMinor * 100 + versionPatch * 10
@@ -34,8 +37,8 @@ android {
         resourceConfigurations += ['en', 'cs', 'de', 'el', 'es', 'fr', 'fr-rCA', 'it', 'nl', 'pl', 'pt', 'pt-rBR', 'ru', 'sl', 'uk', 'zh-rHK']
     }
     applicationVariants.configureEach {
-        buildConfigField "String", "RELEASE_URL", "\"https://api.github.com/repos/${ghOwner}/${ghPackage}/releases/latest\""
-        buildConfigField "String", "REPO_URL", "\"https://github.com/${ghOwner}/${ghPackage}\""
+        buildConfigField "String", "RELEASE_URL", "\"${releaseUrl}\""
+        buildConfigField "String", "REPO_URL", "\"${repoUrl}\""
     }
     signingConfigs {
         debug {
@@ -45,6 +48,12 @@ android {
                 storePassword System.getenv("KEYSTORE_PASSWORD")
                 keyAlias System.getenv("KEY_ALIAS")
                 keyPassword System.getenv("KEY_PASSWORD")
+            } else {
+                // постоянный отладочный ключ из репозитория: новые сборки ставятся поверх старых без удаления
+                storeFile file("petrol-debug.keystore")
+                storePassword "android"
+                keyAlias "androiddebugkey"
+                keyPassword "android"
             }
         }
     }
