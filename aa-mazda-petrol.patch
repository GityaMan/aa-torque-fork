+/**
+ * Поездка: сколько проехали и сколько топлива ушло. Переживает кратковременные обрывы связи,
+ * а после стоянки дольше 10 минут начинается заново.
+ */
+object Trip {
+    private const val IDLE_RESET_MS = 10 * 60_000L
+
+    @Volatile var liters = 0.0
+        private set
+    @Volatile var km = 0.0
+        private set
+    @Volatile private var lastUpdate = 0L
+
+    @Synchronized
+    fun add(litersPerHour: Double?, speedKmh: Double?, dtSec: Double) {
+        val now = System.currentTimeMillis()
+        if (lastUpdate != 0L && now - lastUpdate > IDLE_RESET_MS) { liters = 0.0; km = 0.0 }
+        lastUpdate = now
+        if (litersPerHour != null) liters += litersPerHour * dtSec / 3600.0
+        if (speedKmh != null) km += speedKmh * dtSec / 3600.0
+    }
+
+    /** Средний расход, л/100 км. Пока не проехали 0.5 км — пусто. */
+    fun avgPer100(): Double? = if (km >= 0.5) liters / km * 100.0 else null
+
+    @Synchronized
+    fun reset() { liters = 0.0; km = 0.0; lastUpdate = 0L }
+}
